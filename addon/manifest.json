{
  "manifest_version": 2,
  "name": "Browser Search for Alfred",
  "version": "0.1.0",
  "description": "Lists this browser's tabs and brings one to the front when Alfred asks.",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-search-for-alfred@shariqh.github.io"
    }
  },
  "permissions": ["nativeMessaging", "tabs"],
  "background": {
    "scripts": ["handler.js", "background.js"],
    "persistent": true
  }
}
